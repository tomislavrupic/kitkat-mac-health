{
  "name": "kitkat-mac-health-landing",
  "version": "0.7.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "GITHUB_PAGES=true NEXT_PUBLIC_BASE_PATH=${NEXT_PUBLIC_BASE_PATH-/kitkat-mac-health} next build",
    "export:portable": "node scripts/export-portable.mjs",
    "start": "next start",
    "test": "npm run build:pages && node --test tests/*.test.mjs",
    "audit:security": "npm audit --audit-level=low",
    "lint": "biome lint --error-on-warnings .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
